# FM-SDR-Tuner configuration file
# Run with: ./build/fm-sdr-tuner -c fm-sdr-tuner.ini
# CLI flags override values here.
#
# This profile is the one that works on this site: an RTL-SDR (R820T) with the
# indoor telescopic antenna, and the fm-dx-webserver plugin as the control
# surface. The [rest] section below is therefore enabled and points at the
# plugin's default URL (http://127.0.0.1:9090).
#
# The values that are not the generic defaults are marked "measured": they come
# from the real hardware, and the numbers behind them are in the README's
# "Setup And Tuning Guide". Re-measure them after a change of antenna or
# cable - ./build/fm-sdr-tuner --calibrate prints the meter window to use.

# =========================
# SDR Input / RF Tuning
# =========================

[tuner]
# Source: rtl_sdr (direct USB), rtl_tcp (network server), or sdrplay (RSP series).
# NOTE: the macOS and Linux prebuilt binaries are SDRplay-capable — just install
# the SDRplay API service (sdrplay.com) and set source=sdrplay. The SDRplay
# library is dlopen'd at runtime, so the binary also runs fine on RTL-only
# systems. Windows is RTL-only (no SDRplay loader). Building SDRplay from source
# needs -DFM_TUNER_ENABLE_SDRPLAY=ON (macOS/Linux). If no RSP is present, use
# rtl_sdr (or --source rtl_sdr).
source = rtl_sdr

# RTL-SDR device index when source=rtl_sdr
rtl_device = 0

# Startup frequency in kHz (96200 = 96.2 MHz) - the local station measured
# here.
default_freq = 96200

# De-emphasis: 0=50us, 1=75us, 2=off
deemphasis = 0

[sdrplay]
# SDRplay RSP front-end settings (used only when source=sdrplay; ignored on RTL).
# Enable the RSP hardware IF AGC (recommended). When on it overrides the [sdr]
# manual-gain/TEF path for SDRplay and trims IF gain to avoid overload.
agc = true
# Front-end LNA gain-reduction step (0 = most gain). 8 keeps strong broadcast
# FM out of front-end overload while the AGC trims the IF gain.
lna_state = 8
# Antenna input: RSPdx/RSPdxR2 -> 0=A, 1=B, 2=C; ignored on single-input models.
antenna = 0
# Enable the RSP bias-tee (model-specific).
bias_tee = false

[rtl_tcp]
# Used only when source=rtl_tcp
host = localhost
port = 1234

# RTL input sample rate.
# Supported: 256000, 1024000, 2048000.
# Higher rates are front-end decimated to 256000 for the DSP stereo chain.
sample_rate = 256000

[sdr]
# Gain strategy:
#   tef   = TEF-like A/G behavior (supports auto clip-protect loop)
#   sdrpp = SDR++-style gain behavior
gain_strategy = tef

# Manual tuner gain in dB.
#   -1 = strategy-managed gain (the auto-gain ladder picks the level)
#   >=0 = a fixed manual gain (overrides the ladder + switches the front
#        end's own AGC off)
#
# Measured on this site (R820T, indoor antenna, the local station on 96.2):
#   10 dB  -> the station sits at -19 dBFS, its peaks 9.7 dB below the
#             converter's ceiling, and the meter reads 91-100 of 120.
#   12 dB  -> peaks 7.3 dB below the ceiling, the meter pegs at the top.
#   14 dB  -> peaks 5.4 dB below the ceiling.
#   auto   -> the ladder climbs to 18 dB on this station: peaks only 3.4 dB
#             below the ceiling, which is one strong neighbour away from
#             clipping.
# So: a fixed 10 dB. It leaves the most headroom, it does not pump, and the
# meter stays off the top of the scale.
#
# The gain in this file is the STARTING point: the plugin's gain control (and
# an XDR client) may move it while the tuner runs, and the setting then
# survives a retune. A -g on the command line pins the gain instead - no
# client may change it after that.
rtl_gain_db = 10

# RTL frequency correction in ppm (set from known dongle offset)
freq_correction_ppm = 0

# Packed custom gain flags (tef strategy): tens=RF, ones=IF
# Example: 11 => RF=1, IF=1
#
# The IF flag turns the dongle's OWN AGC on. That AGC sets the level by
# itself, so the software auto-gain ladder has to stand down and can no
# longer protect the front end: the level it targets is an average, while an
# FM station's peaks sit several dB above it. Leave the IF flag off (0) and
# the software ladder stays in charge, with its clip-protect. The plugin's
# "RTL digital AGC" button switches this flag at runtime; the switch costs a
# short silence (~600 ms) because the front end's own AGC overshoots into the
# clipper for that long, and the tuner drops that burst instead of playing it.
default_custom_gain_flags = 0

# SDR++ strategy options (used when gain_strategy=sdrpp)
sdrpp_rtl_agc = false
sdrpp_rtl_agc_gain_db = 18

# Quick presets:
#
# Preset A: TEF (stable, auto clip-protect)
#   gain_strategy = tef
#   rtl_gain_db = -1
#   default_custom_gain_flags = 0
#   agc_mode = 2
#
# Preset B: SDR++ (predictable/manual-like)
#   gain_strategy = sdrpp
#   rtl_gain_db = -1
#   sdrpp_rtl_agc = false
#   sdrpp_rtl_agc_gain_db = 18
#   agc_mode = 2   ; ignored by sdrpp strategy

# Signal meter. The displayed 0..120 level is the ABSOLUTE mapping of the
# compensated dBFS onto the window below:
#   level = (compensated dBFS - floor) / (ceil - floor) * 120
# The compensation takes half of the applied gain out of the reading, so the
# level of a station stays comparable when the gain strategy changes.
# The three keys below set that window:
#   - too narrow → strong locals hit the top AND weak stations clamp to 0
#   - too wide  → mid-strength stations look smaller than they are
# Easiest workflow: run `./fm-sdr-tuner --calibrate` once with your antenna
# connected — it sweeps the band and prints copy-paste-ready values for the
# three keys below. Alternative: leave the shipped values and let the
# [METER] session log line guide you.
#
# The values below are MEASURED on this site with the indoor antenna and the
# 10 dB gain above: the empty band reads 0.0 and the local station on 96.2
# reads 91-100 of 120. Widen the window if your site is quieter, narrow it if
# your stations are stronger.
#
# The window belongs to the gain setting: the dongle's own AGC puts the same
# station ~5 dB higher, so with the AGC on the meter pegs at 120 until the
# window is moved up (floor=-21, ceil=-9 was measured here). The [METER]
# session line prints the window that fits the session it saw.
#
# The spectral scan reports the same number for the same signal: the scan and
# the meter measure the same spectrum through the same estimator and the same
# 30 kHz window.
signal_floor_dbfs = -43.0
signal_ceil_dbfs = -19.0
signal_bias_db = 0.0

# Spectral-scan plot scale. The scan line is the spectrum of the band: every
# grid point reports the level of the signal meter at that frequency, so the
# plot reads like a spectrum display and a signal that is not a station stays
# a bump in the noise floor.
#
# The reference client (xdr-gtk) draws the scan in a FIXED 3..84 window and
# clips everything outside it, so a scan reported on the meter's 0..120 scale
# pins every strong station flat against the top of the plot. When enabled,
# the scan line is remapped onto this window; the "S" line and the REST status
# keep the 0..120 scale, because the clients that read those convert it
# themselves (the webserver's dBm mode subtracts 120, the plugin shows it out
# of 120).
scan_use_client_window = true
scan_client_min_level = 3.0
scan_client_max_level = 84.0

# Drop stale IQ backlog when overloaded
low_latency_iq = false

# =========================
# Audio / Decode
# =========================

[audio]
# Enable speaker output by default (same as -s)
enable_audio = true

# Startup audio volume in percent (0..100)
startup_volume = 80

# Output device index/name (empty = system default)
device =

[processing]
# TEF AGC profile (0..3). Used by gain_strategy=tef. It only matters when the
# gain is automatic: with the fixed rtl_gain_db above, the ladder stands down.
agc_mode = 2

# Allow a client to change the gain (the plugin's gain control over REST, an
# XDR client over the XDR protocol). true is what the plugin needs. Set it to
# false to freeze the gain - and with it the meter calibration - against a
# client that would otherwise move it.
client_gain_allowed = true

# DSP block size (IQ samples per processing cycle)
dsp_block_samples = 8192

# FM channel bandwidth hint in Hz (194000 recommended for WFM stereo)
w0_bandwidth_hz = 194000

# Optional DSP AGC before FM discriminator: off, fast, slow
dsp_agc = off

# Stereo blend profile: soft, normal, aggressive
#
# Measured on this site (2026-10-22, the local station on 96.2): the station's
# stereo quality estimate dips regularly, and the "aggressive" profile follows
# every dip. Two back-to-back captures of the same station, 52 s each, measured
# as the RMS of the L-R difference over the RMS of L+R:
#   aggressive -> -25.2 dB, swinging over 22 dB, 6% of the seconds fully muted
#   normal    -> -16.9 dB, swinging over  6 dB, no muted seconds at all
# So the aggressive profile leaves the image 8 dB weaker and makes it collapse
# and come back - that is the "bad sound" on a clean local station. "normal"
# is the default. "aggressive" is still worth it on a station whose stereo is
# noisy rather than clean.
stereo_blend = normal

# Enable stereo decoder
stereo = true

# 19 kHz pilot canceller. Two-tap LMS subtracts the residual pilot tone from
# the mono audio path; ~20+ dB additional suppression beyond the audio LPF.
# Default on — only audible improvement, no behavioral surprise.
pilot_canceller = true

# Adaptive de-emphasis ("HiCut") — narrows the top-end de-emphasis when
# the stereo decoder reports low signal quality. Crossfades into a steeper
# curve to suppress hiss on fringe stations without touching clean ones.
#   off    = no adaptive HiCut (default)
#   gentle = narrow tau = 2x configured (mild HF rolloff on weak signal)
#   strong = narrow tau = 5x configured (aggressive hiss suppression)
hicut = off

# Adaptive channel bandwidth — automatically narrows the channel FIR when
# SNR is low (adjacent splatter or weak signal), widens when SNR recovers.
# Hysteresis: changes at most every 2 s. Off keeps the static w0_bandwidth_hz.
#   off          = use the static w0_bandwidth_hz only (default)
#   conservative = 3-band (95/142/194 kHz)
#   aggressive   = 5-band (36/56/95/130/200 kHz)
adaptive_bandwidth = off

# Multipath equalizer — CMA-based complex equalizer in the I/Q path before the
# discriminator. On clean signals stays near transparent (dispersion target +
# leak toward centered-delta). On real multipath ghosting it converges to
# flatten the channel envelope. Adaptation is gated by stereo lock so it
# never trains on noise.
#   off        = bypassed (default)
#   light      = small step size, strong leak (safest)
#   aggressive = larger step size, weaker leak (chases stronger multipath)
multipath_eq = off
multipath_eq_taps = 17

# Adaptive fade-mute: smoothly mutes the demod noise burst when the RF signal
# drops out (deep fade / dropout) and fades back in on recovery. Tracks the
# station's own level (FM is constant-envelope, so a channel-power drop is a
# real fade, never quiet program audio), so it won't silence steady weak
# stations. off | gentle (only deep fades) | strong (mutes more readily).
fade_mute = gentle

# IQ channel FIR L1 normalization. When true, the I/Q Kaiser lowpass that
# runs before the discriminator is designed with sum(|tap|)·scale ≤ 1, so
# the output envelope can never exceed the input envelope (|y[n]| ≤ max|x|).
# Without this a non-monotonic Kaiser response can ring past unit envelope
# under ADC-rail saturation, producing post-filter samples whose computed
# power exceeds the input dBFS — confusing the meter and any downstream
# consumer that assumes |IQ| ≤ 1 (e.g. WAV writers / MPX rebroadcast).
# Defaults to false to keep existing meter calibration; turn on if you see
# meter saturation behavior that doesn't match the actual ADC level, or if
# you're piping the IQ stream into a tool that requires strict bounds.
iq_fir_l1_normalize = false

# Channel-power squelch on the 48 kHz audio output (in compensated dBFS).
# Below this threshold the audio is faded to silence with a 30 ms ramp;
# 3 dB of hysteresis prevents flutter at the boundary. Useful for scan /
# DX / unattended workflows where silence on empty channels is preferable
# to hiss. -120 = effectively disabled (default); broadcast-relevant
# values are -90 .. -30.
squelch_dbfs = -120.0

# =========================
# Network / Service
# =========================

[xdr]
# XDR server TCP port
port = 7373

# XDR/FM-DX client password. Empty (default) = no auth: the server runs in
# guest mode so clients like FM-DX-Webserver / XDR-GTK connect without a
# password (fine for localhost / a trusted LAN). Set a value here to require
# it, and configure the same password in your client.
password =

# Allow guest mode without a password. Ignored while password is empty (guest
# mode is then enabled automatically).
guest_mode = false

[rest]
# Anonymous HTTP control API for an fm-dx-webserver client plugin. Carries the
# SDR-specific settings XDR can't (manual dB gain, SDRplay LNA/antenna/bias-tee)
# plus the common ones; works for both RTL and SDRplay. NO authentication by
# design — keep bind_address on localhost or a trusted network only.
# Endpoints: GET /api/status, GET|POST /api/control (query-string or JSON body).
# Test UI: scripts/run_rest_panel.sh
#
# The port and the address below are the plugin's defaults: its backend falls
# back to http://127.0.0.1:9090 when the webserver's config.json has no
# fmSdrTuner.restUrl. The plugin's panel drives the gain, the front end's own
# AGC and the SDRplay LNA/antenna/bias-tee from here; the gain it sets is the
# tuner's own state, so it survives a retune and a reconnect.
enabled = true
port = 9090
bind_address = 127.0.0.1

[reconnection]
# Auto reconnect after repeated IQ read failures
auto_reconnect = true

[debug]
# 0=quiet, 1=info, 2+=verbose
log_level = 1
